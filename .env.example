# Kopieren nach ".env" (Projekt-Root) und Werte anpassen. .env NICHT committen.
# Dient `vercel dev` als lokale Umgebungsvariablen-Quelle (Äquivalent zum
# alten server/.env). Für das Deployment selbst müssen dieselben Variablen
# zusätzlich in Vercel eingetragen werden: Project Settings -> Environment
# Variables (für Production UND Preview).

# Zufälliger, geheimer String zum Signieren der Session-Cookies.
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt-Hash des Zugangspassworts (NICHT das Passwort im Klartext!).
# Erzeugen mit: npm run hash-password -- <dein-passwort>
SITE_PASSWORD_HASH=

# Nur lokal nötig, für `npm run upload-protected-files` (lädt die PDFs aus
# protected-files/ in den privaten Vercel-Blob-Store hoch). Auf Vercel selbst
# NICHT nötig — dort authentifiziert sich die Function automatisch (OIDC),
# sobald der Blob-Store im Projekt verbunden ist.
# Holen: Vercel-Dashboard -> Projekt -> Storage -> (Blob-Store) -> ".env.local".
BLOB_READ_WRITE_TOKEN=
