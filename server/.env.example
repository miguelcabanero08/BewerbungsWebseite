# Kopieren nach ".env" und Werte anpassen. .env NICHT committen.

# Port, auf dem der API-Server läuft.
PORT=3001

# Zufälliger, geheimer String zum Signieren der Session-Cookies.
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt-Hash des Zugangspassworts (NICHT das Passwort im Klartext!).
# Erzeugen mit: npm run hash-password -- <dein-passwort>
SITE_PASSWORD_HASH=

# "production" aktiviert sichere Cookies (nur HTTPS) und liefert den gebauten
# Frontend-Build (../dist) direkt mit aus.
NODE_ENV=development
